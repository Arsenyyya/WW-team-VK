#!/bin/sh
set -eu
task_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$task_root"
export UV_CACHE_DIR="$task_root/.cache/uv"
if command -v uv >/dev/null 2>&1; then
  uv sync --locked
elif [ -x .tools/uv ]; then
  .tools/uv sync --locked
else
  python3 -m pip install --target .bootstrap uv
  .bootstrap/bin/uv sync --locked
fi
